# ─────────────────────────────────────────────────────────────
# telegram-payments — Bot de pagos / acceso premium
# Fuente de verdad de usuarios. NUNCA commitees valores reales.
# ─────────────────────────────────────────────────────────────

# --- Requeridas ---
BOT_TOKEN=                      # Token del bot premium (BotFather)
DATABASE_URL=                   # Postgres de usuarios/pagos (Railway)

# --- Opcionales existentes ---
PICKS_DATABASE_URL=             # Postgres del bot de picks (SOLO LECTURA, para stats reales)
BOT_USERNAME=erikenobi_premiumbot   # Se autoresuelve si falta

# --- Funnel de trial (NUEVAS, ver docs/TRIAL_FUNNEL_ARCHITECTURE.md) ---
TRIAL_DAYS=7                    # Duración de la prueba gratuita (default 7 si no se define)
LANDING_BASE_URL=https://erikenobipicks.com   # Para construir CTAs/links
DEFAULT_UTM_CAMPAIGN=trial_7d   # Campaña por defecto si no llega UTM

# --- Admin / seguridad (externalizar lo hoy hardcodeado en config.py) ---
TELEGRAM_ADMIN_IDS=9330181      # CSV de IDs admin (hoy ADMIN_IDS=[9330181] en código)

# --- Canales premium (externalizar lo hoy hardcodeado; CONFIRMAR mapeo, ver R1) ---
TELEGRAM_PREMIUM_CHAT_ID=       # Canal premium principal (si se unifica)
CANAL_GOLES_ID=-1003818905455
CANAL_CORNERS_ID=-1003895151594
CANAL_PRE_ID=-1003837149453

# --- Pasarela de pago (preparado; hoy el pago es manual sin webhook) ---
PAYMENT_PROVIDER_API_KEY=       # p.ej. Stripe secret key
PAYMENT_WEBHOOK_SECRET=         # Para validar firma del webhook
BIZUM_PHONE=+34660426660        # Hoy hardcodeado en config.py

# --- Operación ---
TIMEZONE=Europe/Madrid
INVITE_EXPIRY_HOURS=24
CHECK_EXPIRATIONS_EVERY_SECONDS=3600
